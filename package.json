{
  "name": "enterprise-xml-analyzer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "prebuild": "npm run vendor",
    "pretest": "npm run vendor",
    "predev": "npm run vendor",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/package.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:performance": "node scripts/performance.mjs",
    "package": "npm run build",
    "verify:package": "node scripts/verify-package.mjs",
    "electron:build": "npm run build && electron-builder --config release/electron/electron-builder.yml --win --x64",
    "format": "prettier --write src tests scripts vite.config.ts playwright.config.ts"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "d3": "7.9.0",
    "exceljs": "4.4.0",
    "idb": "8.0.4",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/d3": "7.4.3",
    "@types/node": "26.6.5",
    "browserify": "17.0.1",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.6",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
